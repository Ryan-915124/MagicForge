# Local source-development profile. Copy to an untracked `.env` and replace
# placeholders only on the developer machine.
MAGICFORGE_PROFILE=development
MAGICFORGE_MODE=bootstrap
BOOTSTRAP_ALLOW_ANONYMOUS_READS=true
MAGICFORGE_API_PORT=8000
MAGICFORGE_WEB_PORT=3000
MAGICFORGE_POSTGRES_PORT=5432
MAGICFORGE_QDRANT_PORT=6333

# Compose consumes the profile-prefixed names below. The current Alpha accepts
# a governed Bootstrap v0.3 artifact rooted inside the fixed private
# development-corpus volume; it is not an arbitrary document importer. Keep
# identity fields empty until that volume and remote Qdrant projection have
# been provisioned together.
MAGICFORGE_DEVELOPMENT_GLM_API_KEY=
MAGICFORGE_DEVELOPMENT_GLM_MODEL=glm-4.7
MAGICFORGE_DEVELOPMENT_CORPUS_ROOT=/var/lib/magicforge/development-corpus
MAGICFORGE_DEVELOPMENT_CORPUS_ID=
MAGICFORGE_DEVELOPMENT_MANIFEST_PATH=
MAGICFORGE_DEVELOPMENT_RECEIPT_PATH=
MAGICFORGE_DEVELOPMENT_MANIFEST_SCHEMA=

# Direct host execution reads the canonical application names.  GLM is
# optional in Development; an empty value leaves only LLM-dependent functions
# unavailable.  If both launch methods are used, keep the GLM values aligned.
GLM_API_KEY=
GLM_MODEL=glm-4.7
PRODUCTION_GLM_EXTRACTION_ENABLED=false

# Local-only service placeholders; do not reuse these values in Production.
DATABASE_URL=postgresql+psycopg://magicforge:change-me@127.0.0.1:5432/magicforge
QDRANT_URL=http://127.0.0.1:6333
ACTIVE_QDRANT_STORAGE_KIND=remote

# Direct host corpus identity.  Blank values do not authorize or publish any
# corpus.  Compose uses the profile-prefixed identity above because host paths
# are deliberately not mounted into containers automatically.
ACTIVE_CORPUS_ROOT=
ACTIVE_CORPUS_ID=
ACTIVE_CORPUS_MANIFEST_PATH=
ACTIVE_CORPUS_RECEIPT_PATH=
ACTIVE_CORPUS_MANIFEST_SCHEMA=

AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
PRODUCTION_QDRANT_WRITES_ENABLED=false
