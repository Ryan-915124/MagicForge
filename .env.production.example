# Production is operator-managed and fail closed. Copy this template to an
# untracked secret-managed environment; never commit populated values.
MAGICFORGE_PROFILE=production
MAGICFORGE_MODE=production
BOOTSTRAP_ALLOW_ANONYMOUS_READS=false

# Compose reads only this explicitly Production-scoped namespace.  The URL
# and password must describe the same database; no value has a usable default.
MAGICFORGE_PRODUCTION_DB_PASSWORD=
MAGICFORGE_PRODUCTION_DATABASE_URL=
MAGICFORGE_PRODUCTION_AUTH_ALLOWED_ORIGINS=https://magicforge.example
MAGICFORGE_PRODUCTION_CORPUS_ID=
MAGICFORGE_PRODUCTION_COLLECTION=magicforge_knowledge_v01
MAGICFORGE_PRODUCTION_GLM_API_KEY=
MAGICFORGE_PRODUCTION_GLM_MODEL=glm-4.7
MAGICFORGE_PRODUCTION_API_PORT=8100
MAGICFORGE_PRODUCTION_WEB_PORT=3100

# Direct host execution reads the canonical application names below.  If both
# launch methods are used, values in the two namespaces must stay aligned.
DATABASE_URL=
GLM_API_KEY=
GLM_MODEL=glm-4.7
PRODUCTION_GLM_EXTRACTION_ENABLED=false

AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS=https://magicforge.example

# These canonical fields support direct-host tooling. The Production API's
# active corpus authority remains the reviewed SQL ActiveCorpusPointer; file
# paths never override that database state.
ACTIVE_CORPUS_ROOT=
ACTIVE_CORPUS_ID=
ACTIVE_CORPUS_MANIFEST_PATH=
ACTIVE_CORPUS_RECEIPT_PATH=
ACTIVE_CORPUS_MANIFEST_SCHEMA=manifest-0.2

ACTIVE_QDRANT_STORAGE_KIND=remote
QDRANT_URL=
QDRANT_COLLECTION_NAME=magicforge_knowledge_v01

# Compose intentionally hard-codes persistent writes and in-process extraction
# off. The canonical fields below apply only to a separately controlled
# direct-host/operator invocation. Enabling the global switch is insufficient:
# all exact fingerprint values must identify the reviewed Manifest.
PRODUCTION_QDRANT_WRITES_ENABLED=false
PRODUCTION_QDRANT_WRITE_MANIFEST_ID=
PRODUCTION_QDRANT_WRITE_MANIFEST_HASH=
PRODUCTION_QDRANT_WRITE_COLLECTION=
PRODUCTION_QDRANT_WRITE_POINT_COUNT=
