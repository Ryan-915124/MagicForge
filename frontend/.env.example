# FastAPI is proxied by Next.js route handlers; never put GLM_API_KEY here.
MAGICFORGE_API_URL=http://127.0.0.1:8000

# Server-only BFF metadata. These must match the FastAPI cookie names.
# They are used to whitelist Cookie and Set-Cookie forwarding.
MAGICFORGE_SESSION_COOKIE_NAME=magicforge_session
MAGICFORGE_CSRF_COOKIE_NAME=magicforge_csrf
# Production defaults to requiring Secure on forwarded auth cookies. Set false
# only for an explicit loopback HTTP development environment.
MAGICFORGE_REQUIRE_SECURE_COOKIES=true

# Must match the readable CSRF cookie configured by AUTH_CSRF_COOKIE_NAME.
# This value is public metadata used by the browser to echo the CSRF token.
NEXT_PUBLIC_MAGICFORGE_CSRF_COOKIE_NAME=magicforge_csrf
