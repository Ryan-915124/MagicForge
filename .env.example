# Required for generation; never commit a real key.
GLM_API_KEY=
GLM_MODEL=glm-4.7
# Keep GLM below the web proxy deadline; retries are disabled by default so
# one slow request cannot silently exceed the end-to-end budget.
GLM_TIMEOUT_SECONDS=90
GLM_MAX_RETRIES=0
# Fail-closed switch for sending an independently approved Production Source
# version to the configured GLM. This never authorizes Qdrant writes.
PRODUCTION_GLM_EXTRACTION_ENABLED=false

# Required by the Production governance persistence layer. The value below is
# only for the local Docker Compose service in docker-compose.dev.yml. Use a
# secret-managed PostgreSQL URL in Production; SQLite is not a supported
# Production fallback.
DATABASE_URL=postgresql+psycopg://magicforge:magicforge_local_only@127.0.0.1:5432/magicforge
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Opaque, revocable authentication sessions. Browser sessions use HttpOnly
# cookies plus a readable double-submit CSRF token; API clients may request a
# bearer session. Keep AUTH_COOKIE_SECURE=true behind HTTPS in Production.
AUTH_SESSION_TTL_SECONDS=43200
AUTH_LAST_USED_UPDATE_INTERVAL_SECONDS=300
AUTH_SESSION_COOKIE_NAME=magicforge_session
AUTH_CSRF_COOKIE_NAME=magicforge_csrf
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional and test-only. Migration integration tests skip unless this points
# to a PostgreSQL database whose user may create and drop isolated schemas.
TEST_DATABASE_URL=

# The generic example is deliberately Production-oriented and fail closed.
# Use `.env.demo.example` or `.env.development.example` for those profiles.
MAGICFORGE_PROFILE=production

# Production is fail-closed until ACTIVE_CORPUS_* identifies an authorized
# production manifest and receipt. Bootstrap mode resolves the audited v0.3
# files below and never falls back to an older collection.
MAGICFORGE_MODE=production

# Optional compatibility boundary for the frozen local Bootstrap corpus only.
# This can never be enabled in Production and grants read/use access only; all
# administrative and future governance mutations still require authentication.
BOOTSTRAP_ALLOW_ANONYMOUS_READS=false

# One API runtime corpus identity. Leave these blank in production until an
# authorized production corpus exists.
ACTIVE_CORPUS_ROOT=
ACTIVE_CORPUS_ID=
ACTIVE_CORPUS_MANIFEST_PATH=
ACTIVE_CORPUS_RECEIPT_PATH=
ACTIVE_CORPUS_MANIFEST_SCHEMA=manifest-0.2

# Runtime Qdrant transport. Local mode is single-process only.
ACTIVE_QDRANT_STORAGE_KIND=remote
ACTIVE_QDRANT_LOCAL_PATH=
QDRANT_URL=http://localhost:6333

# Production ingestion target used by the governed offline writer.
QDRANT_COLLECTION_NAME=magicforge_knowledge_v01
# Keep false until a human has reviewed the exact manifest ID, collection,
# point count, vector shape, and activation procedure. Enabling the global
# switch is insufficient: all four exact fingerprint fields must identify the
# same authorized manifest. Keep these values blank until that separate review.
PRODUCTION_QDRANT_WRITES_ENABLED=false
PRODUCTION_QDRANT_WRITE_MANIFEST_ID=
PRODUCTION_QDRANT_WRITE_MANIFEST_HASH=
PRODUCTION_QDRANT_WRITE_COLLECTION=
PRODUCTION_QDRANT_WRITE_POINT_COUNT=

# Historical Bootstrap v0.2 writer settings. These do not select the API
# runtime corpus and remain only for the frozen offline pipeline.
QDRANT_BOOTSTRAP_COLLECTION_NAME=magicforge_bootstrap_v02
QDRANT_BOOTSTRAP_LOCAL_PATH=

# Public source releases do not include a Bootstrap corpus or local Qdrant
# storage. To use Bootstrap mode, obtain a separately licensed demo corpus and
# point every ACTIVE_CORPUS_* value at its verified manifest and receipt. Never
# copy a private research run into a public checkout.

# Replaceable local embedding provider configuration.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

RETRIEVAL_LIMIT=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
