# Synthetic, anonymous, read-only Demo profile. Copy to an untracked `.env`
# only when overriding the defaults in compose.yaml.
MAGICFORGE_PROFILE=demo
MAGICFORGE_MODE=bootstrap
BOOTSTRAP_ALLOW_ANONYMOUS_READS=true

# Demo does not require an LLM and cannot authorize Production extraction or
# persistent Production projection.
GLM_API_KEY=
PRODUCTION_GLM_EXTRACTION_ENABLED=false
PRODUCTION_QDRANT_WRITES_ENABLED=false

# Loopback-only published ports may be changed when they are already occupied.
MAGICFORGE_WEB_PORT=3000
MAGICFORGE_API_PORT=8000
MAGICFORGE_POSTGRES_PORT=5432
MAGICFORGE_QDRANT_PORT=6333

# HTTP cookies are acceptable only for this loopback Demo profile.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
